rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed(){return request.auth!=null;}
  function admin(){return signed() && request.auth.token.admin==true;}
  match /users/{uid} { allow read: if signed() && (request.auth.uid==uid || admin()); allow create,update: if signed() && (request.auth.uid==uid || admin()); allow delete: if admin();
    match /favorites/{rid} { allow read,write: if signed() && request.auth.uid==uid; }
    match /fcmTokens/{tid} { allow read,write: if signed() && request.auth.uid==uid; }
  }
  match /rooms/{id} { allow read: if resource.data.status=='approved' || (signed() && resource.data.ownerId==request.auth.uid) || admin(); allow create: if signed() && request.resource.data.ownerId==request.auth.uid; allow update: if (signed() && resource.data.ownerId==request.auth.uid && request.resource.data.ownerId==resource.data.ownerId) || admin(); allow delete: if (signed() && resource.data.ownerId==request.auth.uid) || admin(); }
  match /conversations/{cid} { allow read,create,update: if signed() && (request.auth.uid in resource.data.participants || request.auth.uid in request.resource.data.participants || admin());
    match /messages/{mid} { allow read,create: if signed() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(cid)).data.participants; allow update: if signed() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(cid)).data.participants; }
  }
  match /reports/{id} { allow create: if signed() && request.resource.data.reporterId==request.auth.uid; allow read,update,delete: if admin(); }
 }
}
